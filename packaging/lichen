#!/bin/sh
# Lichen launcher.
APPDIR="$(dirname "$(readlink -f "$0")")"
# The SSH bundle keeps this script beside bin/. System packages and AppDir install
# it in PREFIX/bin and keep private resources in PREFIX/libexec/lichen.
if [ ! -x "$APPDIR/bin/lichen" ]; then
  APPDIR="$(cd "$APPDIR/../libexec/lichen" && pwd)" || exit 1
fi
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

# Same locations as the Qt desktop app: settings in ~/.config/OrganicMaps, maps and bookmarks in
# ~/.local/share/OrganicMaps.
mkdir -p "$DATA_HOME/OrganicMaps" "$CONFIG_HOME/OrganicMaps"
export MWM_RESOURCES_DIR="$APPDIR/data/"
export MWM_WRITABLE_DIR="$DATA_HOME/OrganicMaps/"

exec "$APPDIR/bin/lichen" "$@"
