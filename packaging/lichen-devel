#!/bin/sh
# Lichen Preview launcher (the CoMaps core prototype).
APPDIR="$(dirname "$(readlink -f "$0")")"
# The SSH bundle keeps this script beside bin/. System packages and AppDir install
# it in PREFIX/bin and keep private resources in PREFIX/libexec/lichen-devel.
if [ ! -x "$APPDIR/bin/lichen" ]; then
  APPDIR="$(cd "$APPDIR/../libexec/lichen-devel" && pwd)" || exit 1
fi
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

# Same locations as the CoMaps desktop app: maps in ~/.local/share/CoMaps; the core keeps settings
# and bookmarks in ~/.config/CoMaps. The Organic Maps directories of the regular Lichen are never
# used, so both apps run side by side.
mkdir -p "$DATA_HOME/CoMaps"
export MWM_RESOURCES_DIR="$APPDIR/data/"
export MWM_WRITABLE_DIR="$DATA_HOME/CoMaps/"

exec "$APPDIR/bin/lichen" "$@"
